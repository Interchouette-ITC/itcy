{
  "browser": {
    "browserName": "chromium",
    "isolated": false,
    "launchOptions": {
      "executablePath": "/usr/bin/chromium",
      "chromiumSandbox": true,
      "args": [
        "--lang=en-US",
        "--accept-lang=en-US,en;q=0.9,fr;q=0.8",
        "--hide-crash-restore-bubble",
        "--disable-session-crashed-bubble",
        "--disable-features=Translate,TranslateUI,TranslatePhraseCapture,AdaptiveButtonInTopToolbarGoogleTranslate,LanguageDetectionMaxLength"
      ]
    },
    "contextOptions": {
      "locale": "en-US",
      "viewport": { "width": 1280, "height": 720 },
      "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36"
    }
  }
}
